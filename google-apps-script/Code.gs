const SHEET_NAME='Data';const USERS_SHEET='Users';const TOKEN='';function doGet(){return json_({ok:true,service:'Owner Dashboard Sync',version:1})}function doPost(e){try{const b=JSON.parse(e.postData.contents||'{}');if(TOKEN&&b.token!==TOKEN)return json_({ok:false,error:'Unauthorized'});if(b.action==='saveUsers')return saveUsers_(b.storeCode,b.users||[]);if(b.action==='loadUsers')return loadUsers_(b.storeCode);if(b.action==='saveData')return saveData_(b.storeCode,b.data||{});if(b.action==='loadData')return loadData_(b.storeCode);return json_({ok:false,error:'Unknown action'})}catch(err){return json_({ok:false,error:String(err)})}}function sheet_(n){const s=SpreadsheetApp.getActiveSpreadsheet();return s.getSheetByName(n)||s.insertSheet(n)}function saveUsers_(c,u){if(!c)return json_({ok:false,error:'Missing storeCode'});const s=sheet_(USERS_SHEET);s.clearContents();s.getRange(1,1,1,3).setValues([['storeCode','updatedAt','usersJson']]);s.getRange(2,1,1,3).setValues([[String(c).toUpperCase(),new Date().toISOString(),JSON.stringify(u)]]);return json_({ok:true})}function loadUsers_(c){const r=sheet_(USERS_SHEET).getDataRange().getValues();for(let i=1;i<r.length;i++)if(String(r[i][0]).toUpperCase()===String(c).toUpperCase())return json_({ok:true,users:JSON.parse(r[i][2]||'[]')});return json_({ok:true,users:[]})}function saveData_(c,d){if(!c)return json_({ok:false,error:'Missing storeCode'});const s=sheet_(SHEET_NAME),r=s.getDataRange().getValues(),code=String(c).toUpperCase(),now=new Date().toISOString(),payload=JSON.stringify(d);let row=-1;for(let i=1;i<r.length;i++)if(String(r[i][0]).toUpperCase()===code){row=i+1;break}if(row<0)s.appendRow([code,now,payload]);else s.getRange(row,1,1,3).setValues([[code,now,payload]]);return json_({ok:true,updatedAt:now})}function loadData_(c){const r=sheet_(SHEET_NAME).getDataRange().getValues(),code=String(c).toUpperCase();for(let i=1;i<r.length;i++)if(String(r[i][0]).toUpperCase()===code)return json_({ok:true,updatedAt:r[i][1],data:JSON.parse(r[i][2]||'{}')});return json_({ok:true,updatedAt:null,data:null})}function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}